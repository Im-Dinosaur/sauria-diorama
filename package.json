{
  "name": "ember-archive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "verify": "tsx scripts/verify-ecosystem.ts && tsx scripts/verify-dinosaur-production.ts && tsx scripts/verify-reference.ts && tsx scripts/verify-navigation.ts && tsx scripts/verify-drinking.ts && tsx scripts/verify-map-tyrannosaurus.ts && tsx scripts/verify-physical-scale.ts && npm run verify:realistic-map && npm run verify:interaction",
    "verify:realistic-map": "node --import tsx scripts/verify-realistic-map.ts",
    "verify:interaction": "node --import tsx scripts/verify-observation-disaster.ts",
    "build:web-assets": "node scripts/build-web-assets.mjs",
    "verify:performance": "node --import tsx scripts/verify-performance.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.3.0",
    "@react-three/postprocessing": "^3.0.4",
    "leva": "^0.10.0",
    "lucide-react": "^0.468.0",
    "postprocessing": "^6.38.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.3.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.3",
    "meshoptimizer": "0.22.0",
    "sharp": "^0.34.5",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vite": "^7.1.7"
  }
}
