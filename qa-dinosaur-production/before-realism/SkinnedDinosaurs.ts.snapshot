type V=[number,number,number];
type Finish='skin'|'horn'|'mouth'|'eye'|'iris'|'feather'|'membrane';
export type DinosaurAction='idle'|'walk'|'run'|'roar'|'drink'|'graze'|'browse'|'rest'|'alert'|'hunt'|'fish'|'fly'|'glide'|'display';
